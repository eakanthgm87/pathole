# Copy to backend/.env and edit. Never commit the real file.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# sqlite (default, zero setup) or postgres
DB_ENGINE=sqlite
DB_NAME=pothole
DB_USER=pothole
DB_PASSWORD=pothole
DB_HOST=localhost
DB_PORT=5432

# Detection. Thresholds here are fallbacks; the active ModelVersion row wins.
DEFAULT_WEIGHTS=best.pt
CONF_THRESHOLD=0.20
REVIEW_THRESHOLD=0.12
DETECTION_IMGSZ=640
LIVE_IMGSZ=480
LIVE_CONF=0.35

DUPLICATE_RADIUS_M=15
MAX_UPLOAD_BYTES=8388608
MAP_POINT_CAP=5000

REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=1
AXES_ENABLED=0
LOG_LEVEL=INFO
